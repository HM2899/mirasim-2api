# The folder written by `npm run login -- email` or `npm run login -- github`.
# When omitted, the official Mirasim default is ~/.mirasim.
# MIRASIM_HOME=/home/user/.mirasim

# Local storage for console-generated OpenAI API Key hashes. API Keys themselves
# are shown once at creation and are never stored in plaintext.
# MIRASIM_API_KEYS_FILE=/home/user/.mirasim/api-keys.json

# Optional: one or more independently logged-in Mirasim profile folders.
# Requests are round-robin across valid profiles. A 429 or 5xx response fails
# over to the next profile and cools down the failed profile.
# MIRASIM_HOMES=/srv/mirasim/profile-a,/srv/mirasim/profile-b

# The service only listens on loopback by default.
HOST=127.0.0.1
PORT=8787

# Web console login. When WEB_AUTH_PASSWORD is omitted, each service start
# prints a generated one-time password. Set it to keep a fixed password.
WEB_AUTH_USERNAME=admin
# WEB_AUTH_PASSWORD=replace-with-a-long-password
# Set true only when HTTPS terminates at this process.
# WEB_AUTH_SECURE_COOKIE=false

# Optional fallback model IDs when the live upstream directory is unavailable.
# MIRASIM_MODELS=gpt-5,claude-sonnet-4-5

# Optional Mirasim relay settings. Defaults match v0.0.147.
# MIRASIM_RELAY_URL=https://mirasim-relay.mirofish.ai
# MIRASIM_LOGIN_URL=https://admin.mirofish.ai
# Hard cap for the upstream response-header wait, in milliseconds.
# MIRASIM_TIMEOUT_MS=300000
# The default response-header wait is 45000 ms; streaming may continue after headers arrive.
# MIRASIM_FIRST_BYTE_TIMEOUT_MS=45000
# GET /v1/models has a shorter 10000 ms timeout and falls back to MIRASIM_MODELS.
# MIRASIM_MODEL_LIST_TIMEOUT_MS=10000
# MIRASIM_COOLDOWN_MS=30000
