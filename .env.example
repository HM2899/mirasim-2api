# The folder written by `npm run login -- email` or `npm run login -- github`.
# When omitted, the official Mirasim default is ~/.mirasim.
# MIRASIM_HOME=/home/user/.mirasim

# Local storage for console-generated OpenAI API Key hashes. API Keys themselves
# are shown once at creation and are never stored in plaintext.
# MIRASIM_API_KEYS_FILE=/home/user/.mirasim/api-keys.json

# Optional: one or more independently logged-in Mirasim profile folders.
# Requests are round-robin across valid profiles. A 429 or 5xx response fails
# over to the next profile and cools down the failed profile.
# MIRASIM_HOMES=/srv/mirasim/profile-a,/srv/mirasim/profile-b

# The service only listens on loopback by default.
HOST=127.0.0.1
PORT=8787

# Web console login. When WEB_AUTH_PASSWORD is omitted, each service start
# prints a generated one-time password. Set it to keep a fixed password.
WEB_AUTH_USERNAME=admin
# WEB_AUTH_PASSWORD=replace-with-a-long-password
# Set true only when HTTPS terminates at this process.
# WEB_AUTH_SECURE_COOKIE=false

# Optional fallback model IDs when the live upstream directory is unavailable.
# MIRASIM_MODELS=gpt-5,claude-sonnet-4-5

# Model health probing. The scheduled task probes one model per tick in rotation,
# so a full sweep of N models takes N x this interval. Default: 30 minutes.
# MIRASIM_MODEL_HEALTH_INTERVAL_MS=1800000
# MIRASIM_MODEL_HEALTH_TIMEOUT_MS=12000

# Optional relay settings. Bundled runtime and default client version: v0.0.516.
# MIRASIM_RELAY_URL=https://relay.mirasim.ai
# MIRASIM_LOGIN_URL=https://auth.mirasim.ai
# MIRASIM_CLIENT_VERSION=0.0.516
# Optional: advertise only image model IDs whose relay entitlement you have verified.
# MIRASIM_IMAGE_MODELS=gpt-image-1
# Image generation/edit first-byte deadline; capped by MIRASIM_TIMEOUT_MS.
# MIRASIM_IMAGE_TIMEOUT_MS=180000
# Official bundled CLI privacy controls (default off when using npm run login/relay).
# MIRASIM_ANALYTICS=0
# MIRASIM_DIAG=0
# MIRASIM_RECORD=0
# Relay upstreams beyond the default one, as models added to GET /v1/models. Empty by default:
# the relay refuses every DeepSeek and Kimi id today, so advertising them would hand clients
# models that cannot be served. Turn on if the relay starts serving them — requests already go
# out under the right x-mirasim-agent. Comma-separated, or "none".
# MIRASIM_RELAY_AGENTS=dsh,kimi,zcode
# Hard cap for the upstream response-header wait, in milliseconds.
# MIRASIM_TIMEOUT_MS=300000
# API request body limit: default 16 MiB, capped at 64 MiB.
# MIRASIM_MAX_REQUEST_BYTES=16777216
# The default response-header wait is 45000 ms; streaming may continue after headers arrive.
# MIRASIM_FIRST_BYTE_TIMEOUT_MS=45000
# Kimi has a separate 120000 ms response-header wait, also capped by MIRASIM_TIMEOUT_MS.
# MIRASIM_KIMI_FIRST_BYTE_TIMEOUT_MS=120000
# Requests settled at medium/high/xhigh/max thinking get the same 120000 ms allowance: their
# first byte arrives late by nature, and abandoning the wait fails over to an account whose
# prompt cache is cold.
# MIRASIM_THINKING_FIRST_BYTE_TIMEOUT_MS=120000
# Claude requests get 180000 ms: the relay queues them before sending any header. Streaming
# callers are kept connected with protocol-native heartbeats while they wait.
# MIRASIM_CLAUDE_FIRST_BYTE_TIMEOUT_MS=180000
# GET /v1/models has a shorter 10000 ms timeout and falls back to MIRASIM_MODELS.
# MIRASIM_MODEL_LIST_TIMEOUT_MS=10000
# Allowance for a stream's first content after its headers, independent of header timeouts.
# MIRASIM_STREAM_IDLE_TIMEOUT_MS=300000
# Once content has reached the caller, an upstream silence only ends the stream after this long;
# until then the caller gets a heartbeat (`event: ping` / SSE comment) every MIRASIM_STREAM_HEARTBEAT_MS.
# MIRASIM_STREAM_STALL_TIMEOUT_MS=1800000
# MIRASIM_STREAM_HEARTBEAT_MS=15000
# Safety limits in bytes. These can be lowered, but not raised above the defaults.
# MIRASIM_MAX_STREAM_BYTES=16777216
# MIRASIM_MAX_SSE_FRAME_BYTES=2097152
# MIRASIM_COOLDOWN_MS=30000
# How the rotation orders accounts inside one priority tier. Only the seed for a fresh pool: the
# console writes the operator's choice to SQLite, and the stored one wins at every later start.
# spread     = 均摊, the account with the most left first (default)
# waterfall  = 榨干, the account with the least left first
# roundRobin = 纯轮流, ignore the meters and take turns
# MIRASIM_ROTATION_MODE=spread
# Response-header failover budget, extended to at least one full model-specific wait.
# Retries use only the remaining budget, not a fresh full timeout. Body limits are separate.
# MIRASIM_FAILOVER_BUDGET_MS=60000
# Pass through explicit reasoning settings by default. Only cross-protocol field mapping applies.
# Native thinking/reasoning objects and effort names are not upgraded, defaulted or disabled.
# Use managed to opt back into the legacy defaults, normalization and effort floor below.
# MIRASIM_REASONING_MODE=passthrough
# Answer exact Codex automatic task-title prompts locally, without upstream token use.
# Set false to restore model-generated titles. Ordinary conversation is unaffected.
# MIRASIM_LOCAL_CODEX_TITLES=true
# The following two settings only apply in managed mode.
# Thinking level for translated claude-* requests that say nothing about reasoning.
# One of none, minimal, low, medium, high, xhigh, max, ultra (mapped to max),
# ultracode (mapped to xhigh; workflow orchestration remains client-side).
# On a current model (opus-5, sonnet-5,
# opus-4-8, fable-5) this is the rung sent as output_config.effort; on claude-haiku-4-5 it
# becomes a token budget instead.
# MIRASIM_DEFAULT_REASONING_EFFORT=medium
# A floor, not a default: it lifts a level that came in below it and never lowers one that came
# in above. Same vocabulary; none (the default) means no floor. A request that asked for
# no thinking still gets none. Claude Code can send xhigh/max directly; no floor is required.
# MIRASIM_MIN_REASONING_EFFORT=none
# Both settings reach GPT (Codex) turns as well: the relay serves those on its own /v1/responses
# endpoint and accepts the same five rungs, so light/minimal fold to low, "extra high" to xhigh,
# and ultra to max — the desktop client maps ultra down to max itself before anything is sent.
